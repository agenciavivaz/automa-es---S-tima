    {
      "xml_id": "inbound_setima.view_kanban",
      "model": "ir.ui.view",
      "id": 4679,
      "dados": {
        "id": 4679,
        "name": "crm.lead.kanban.inbound_setima",
        "model": "crm.lead",
        "type": "kanban",
        "inherit_id": [
          1469,
          "crm.lead.kanban.lead"
        ],
        "mode": "primary",
        "priority": 99,
        "arch_db": "<data><xpath expr=\"//kanban\" position=\"attributes\">\n                <attribute name=\"class\" add=\"o_inbound_setima\" separator=\" \"/>\n            </xpath>\n            <xpath expr=\"//templates\" position=\"before\">\n                <field name=\"contact_name\"/>\n                <field name=\"partner_name\"/>\n                <field name=\"email_from\"/>\n                <field name=\"phone\"/>\n                <field name=\"x_abm_dias_estagio\"/>\n                <field name=\"activity_state\"/>\n                <field name=\"activity_summary\"/>\n                <field name=\"activity_type_id\"/>\n                <field name=\"activity_type_icon\"/>\n                <field name=\"activity_date_deadline\"/>\n                <field name=\"campaign_id\"/>\n                <field name=\"x_meta_conjunto\"/>\n                <field name=\"x_meta_anuncio\"/>\n            </xpath>\n            <xpath expr=\"//t[@t-name='card']\" position=\"replace\">\n                <t t-name=\"card\">\n                    <widget name=\"web_ribbon\" title=\"Perdido\" bg_color=\"text-bg-danger\" invisible=\"won_status != 'lost'\"/>\n                    <widget name=\"web_ribbon\" title=\"Ganho\" bg_color=\"text-bg-success\" invisible=\"won_status != 'won'\"/>\n                    <div t-att-class=\"'border-start border-4 ps-2 d-flex flex-column gap-2 ' + (record.activity_state.raw_value == 'overdue' ? 'border-danger' : record.activity_state.raw_value == 'today' ? 'border-warning' : record.activity_state.raw_value == 'planned' ? 'border-success' : 'border-secondary')\">\n                        <div class=\"d-flex justify-content-between align-items-start gap-2\">\n                            <div class=\"text-truncate\">\n                                <field name=\"name\" class=\"fw-bold fs-6 d-block text-truncate\"/>\n                                <span class=\"small text-muted text-truncate d-block\">\n                                    <t t-out=\"record.partner_name.raw_value or record.contact_name.raw_value or ''\"/>\n                                </span>\n                            </div>\n                            <field name=\"priority\" widget=\"priority\"/>\n                        </div>\n\n                        <div class=\"d-flex flex-wrap gap-1\">\n                            <field name=\"tag_ids\" widget=\"many2many_tags\" options=\"{'color_field': 'color'}\"/>\n                            <span t-if=\"record.expected_revenue.raw_value\" class=\"badge rounded-pill text-bg-light border\">\n                                <field name=\"expected_revenue\" widget=\"monetary\" options=\"{'currency_field': 'company_currency'}\"/>\n                            </span>\n                        </div>\n\n                        <div t-if=\"record.x_meta_anuncio.raw_value or record.x_meta_conjunto.raw_value or record.campaign_id.raw_value\" class=\"d-flex flex-column gap-1 rounded px-2 py-1 small border\">\n                            <span t-if=\"record.x_meta_anuncio.raw_value\" class=\"text-truncate\" t-att-title=\"'Criativo: ' + record.x_meta_anuncio.raw_value\">\n                                <i class=\"fa fa-picture-o me-1 text-primary\"/><b>Criativo:</b> <t t-out=\"record.x_meta_anuncio.raw_value\"/>\n                            </span>\n                            <span t-if=\"record.x_meta_conjunto.raw_value\" class=\"text-truncate\" t-att-title=\"'Conjunto: ' + record.x_meta_conjunto.raw_value\">\n                                <i class=\"fa fa-users me-1 text-primary\"/><b>Conjunto:</b> <t t-out=\"record.x_meta_conjunto.raw_value\"/>\n                            </span>\n                            <span t-if=\"record.campaign_id.raw_value\" class=\"text-truncate text-muted\" t-att-title=\"'Campanha: ' + record.campaign_id.value\">\n                                <i class=\"fa fa-bullhorn me-1\"/><t t-out=\"record.campaign_id.value\"/>\n                            </span>\n                        </div>\n\n                        <div class=\"d-flex flex-wrap column-gap-3 small text-muted\">\n                            <span t-if=\"record.email_from.raw_value\" class=\"text-truncate\" t-att-title=\"record.email_from.raw_value\">\n                                <i class=\"fa fa-envelope-o me-1\"/><t t-out=\"record.email_from.raw_value\"/>\n                            </span>\n                            <span t-if=\"record.phone.raw_value\" t-att-title=\"record.phone.raw_value\">\n                                <i class=\"fa fa-whatsapp me-1 text-success\"/><t t-out=\"record.phone.raw_value\"/>\n                            </span>\n                        </div>\n\n                        <div t-if=\"record.activity_date_deadline.raw_value\" t-att-class=\"'d-flex align-items-center gap-2 rounded px-2 py-1 small bg-light ' + (record.activity_state.raw_value == 'overdue' ? 'text-danger' : '')\">\n                            <i t-att-class=\"'fa ' + (record.activity_type_icon.raw_value or 'fa-tasks')\"/>\n                            <span class=\"text-truncate\"><t t-out=\"record.activity_summary.raw_value or record.activity_type_id.value\"/></span>\n                            <field name=\"activity_date_deadline\" widget=\"remaining_days\" class=\"ms-auto text-nowrap\"/>\n                        </div>\n                        <div t-else=\"\" class=\"d-flex align-items-center gap-2 rounded px-2 py-1 small bg-light text-muted\">\n                            <i class=\"fa fa-minus\"/><span>Sem próximo contato agendado</span>\n                        </div>\n                    </div>\n                    <footer class=\"pt-1\">\n                        <div class=\"d-flex align-items-center gap-2 w-100\">\n                            <field name=\"user_id\" widget=\"many2one_avatar_user\" domain=\"[('share', '=', False)]\"/>\n                            <field name=\"activity_ids\" widget=\"kanban_activity\"/>\n                            <span class=\"ms-auto small text-muted\" title=\"Dias na etapa atual\">\n                                <i class=\"fa fa-clock-o me-1\"/><t t-out=\"record.x_abm_dias_estagio.raw_value\"/> d na etapa\n                            </span>\n                        </div>\n                    </footer>\n                </t>\n            </xpath>\n        </data>",
        "active": true
      }
