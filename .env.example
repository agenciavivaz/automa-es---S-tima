# =============================================================================
# Odoo
# =============================================================================
ODOO_URL=https://seu-odoo.odoo.com
ODOO_DB=nome_do_banco
ODOO_USER=seu@email.com

# Perfil OPERACIONAL — usuário de serviço com acesso a Vendas/CRM.
# Usado pelos scripts existentes e por toda a camada odoo/ (leitura e edição
# de registros das equipes 16/17/21).
ODOO_API_KEY=sua_chave_api_odoo

# Perfil CONFIGURAÇÃO — usuário admin. Só é lida dentro de odoo/config/ e só
# serve para a Fase 3 (campos, estágios, tags e automações). Deixe vazia se
# ainda não for usar: as Fases 1 e 2 não precisam dela e nunca caem de volta
# nesta chave.
ODOO_ADMIN_API_KEY=

# Ajustes opcionais da camada odoo/ (têm padrão embutido)
# ODOO_TIMEOUT=30            # segundos por chamada JSON-2
# ODOO_SCHEMA_TTL=86400      # validade do cache de fields_get, em segundos
# ODOO_LOG_LEVEL=INFO        # DEBUG loga modelo/método/domain — nunca headers
# ODOO_DATA_DIR=data/odoo    # destino dos CSV/JSON e do audit.jsonl

# Pipeline (Sales Team) — Campanhas BrandSpot = 17
ODOO_TEAM_ID=17

# Estágio inicial do lead — Lead = 68
ODOO_STAGE_ID=68

# =============================================================================
# DataCrazy (webhooks de "Entrada de Negócios" — Configurações → Integrações)
# =============================================================================
DATACRAZY_WEBHOOK_BRANDSPOT=https://api.datacrazy.io/v1/crm/api/crm/integrations/...
DATACRAZY_WEBHOOK_SETIMA=https://api.datacrazy.io/v1/crm/api/crm/integrations/...

# Só sincroniza leads criados a partir desta data (evita reenviar histórico)
DATACRAZY_SYNC_DESDE=2026-07-15 00:00:00

# Tag de marcação no Odoo para leads já sincronizados
DATACRAZY_TAG=DataCrazy

# =============================================================================
# Google Sheets
# =============================================================================
# Caminho para o arquivo JSON da conta de serviço do Google Cloud
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# ID da planilha (extraído da URL do Sheets)
SPREADSHEET_ID=12UT2WhaIWsjZW-ojJ1Asy6bH3zaTsDLcRdwiKN3D3_I

# Nome da aba (deixe vazio para usar a primeira aba)
SHEET_NAME=

# =============================================================================
# Estado
# =============================================================================
# Arquivo que armazena os IDs dos leads já importados
PROCESSED_IDS_FILE=processed_ids.json
