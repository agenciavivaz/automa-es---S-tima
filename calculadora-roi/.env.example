# =============================================================================
# Calculadora de ROI NGI (Sétima) — variáveis de ambiente
# Copie para .env.local. Nenhuma chave server-side pode ter prefixo NEXT_PUBLIC_.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# URL e anon key são públicas (leitura de benchmarks).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role: SOMENTE server-side. Grava calculos, leads e eventos.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Claude API (narrativa do relatório) ------------------------------------
# Sem esta chave, o relatório usa o texto estático por setor (fallback).
ANTHROPIC_API_KEY=sk-ant-...

# --- Tracking ---------------------------------------------------------------
# GTM já implantado pela Sétima.
NEXT_PUBLIC_GTM_ID=GTM-TSGKH6D2

# --- Conversão --------------------------------------------------------------
# Link de agendamento (Calendly / HubSpot / reunião do time comercial).
NEXT_PUBLIC_AGENDAMENTO_URL=https://setima.cc/PT#contato
NEXT_PUBLIC_POLITICA_PRIVACIDADE_URL=https://setima.cc/PT/politica-de-privacidade

# Alerta imediato de lead Tier A.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Segurança --------------------------------------------------------------
# Origens aceitas nos route handlers (separadas por vírgula).
# Vazio = aceita apenas a própria origem do request.
ORIGENS_PERMITIDAS=https://setima.cc,https://www.setima.cc
