<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="abm_setima_dashboard.Donut">
        <svg viewBox="0 0 42 42" class="o_vas_donut" role="img" t-att-aria-label="donutLabel">
            <circle cx="21" cy="21" r="15.915" fill="none" stroke="#eef0f3" stroke-width="6"/>
            <t t-foreach="donut.segs" t-as="seg" t-key="seg.key">
                <circle cx="21" cy="21" r="15.915" fill="none" t-att-stroke="seg.color" stroke-width="6"
                        t-att-stroke-dasharray="seg.dash" t-att-stroke-dashoffset="seg.offset"/>
            </t>
            <text x="21" y="21.5" text-anchor="middle" class="o_vas_donut_num" t-esc="donut.total"/>
            <text x="21" y="26.5" text-anchor="middle" class="o_vas_donut_lbl" t-esc="donutLabel"/>
        </svg>
    </t>

    <t t-name="abm_setima_dashboard.Dashboard">
        <div class="o_action o_vas h-100 overflow-auto" t-ref="root">

            <!-- ================================================= cabeçalho -->
            <header class="o_vas_wrap o_vas_header">
                <div class="o_vas_titulo">
                    <div class="o_vas_eyebrow">CRM · ABM Sétima</div>
                    <h1>Dashboard estratégico</h1>
                    <div class="o_vas_sub">
                        <span><i class="fa fa-calendar me-1"/><t t-esc="periodLabel"/></span>
                        <t t-if="prevLabel"><span class="o_vas_sep">·</span><span>comparado com <t t-esc="prevLabel"/></span></t>
                        <t t-if="state.raw"><span class="o_vas_sep">·</span><span>atualizado às <t t-esc="state.raw.loadedAt.toFormat('HH:mm')"/></span></t>
                    </div>
                    <div class="o_vas_modo o_vas_noprint" role="radiogroup" aria-label="Tier">
                        <span class="o_vas_rotulo">Tier:</span>
                        <t t-foreach="[['all','Todos'],['1','Tier 1'],['2','Tier 2'],['3','Tier 3']]" t-as="t" t-key="t[0]">
                            <button type="button" role="radio" t-att-aria-checked="state.tier === t[0] ? 'true' : 'false'"
                                    t-att-class="{ 'active': state.tier === t[0] }" t-on-click="() => this.state.tier = t[0]" t-esc="t[1]"/>
                        </t>
                    </div>
                </div>
                <div class="o_vas_controles o_vas_noprint">
                    <div class="o_vas_chips" role="group" aria-label="Período">
                        <t t-foreach="presets" t-as="p" t-key="p.key">
                            <button type="button" class="o_vas_chip" t-att-class="{ 'active': state.preset === p.key }"
                                    t-on-click="() => this.onPreset(p.key)" t-esc="p.label"/>
                        </t>
                    </div>
                    <div class="o_vas_acoes">
                        <t t-if="state.preset === 'custom'">
                            <label class="o_vas_data">De <input type="date" class="form-control form-control-sm" t-att-value="state.from" t-on-change="(ev) => this.onCustomDate('from', ev)"/></label>
                            <label class="o_vas_data">Até <input type="date" class="form-control form-control-sm" t-att-value="state.to" t-on-change="(ev) => this.onCustomDate('to', ev)"/></label>
                        </t>
                        <button type="button" class="btn btn-sm btn-primary" t-on-click="exportarPdf"><i class="fa fa-file-pdf-o me-1"/>Exportar PDF</button>
                        <button type="button" class="btn btn-sm btn-light" title="Atualizar" t-on-click="() => this.load()">
                            <i class="fa fa-refresh" t-att-class="{ 'fa-spin': state.loading }"/>
                        </button>
                    </div>
                </div>
            </header>

            <!-- ================================================= barra de seções (sticky) -->
            <nav class="o_vas_nav o_vas_noprint" aria-label="Seções do painel">
                <div class="o_vas_wrap o_vas_nav_in">
                    <t t-foreach="secoes" t-as="s" t-key="s.key">
                        <a href="#" t-att-class="{ 'active': state.secao === s.key }" t-on-click.prevent="() => this.irPara(s.key)" t-esc="s.label"/>
                    </t>
                </div>
            </nav>

            <div t-if="state.error" class="o_vas_wrap"><div class="alert alert-danger">Não foi possível carregar o painel: <t t-esc="state.error"/></div></div>

            <t t-if="state.raw">
                <t t-set="d" t-value="metrics"/>
                <main class="o_vas_wrap o_vas_corpo" t-att-class="{ 'o_vas_loading': state.loading }">

                    <!-- ============================================ RESUMO -->
                    <section id="vas_resumo" class="o_vas_secao">
                        <div class="o_vas_secao_titulo">Resumo do período</div>
                        <div class="o_vas_kpis">
                            <t t-foreach="d.kpis" t-as="k" t-key="k.key">
                                <div class="o_vas_card o_vas_kpi" t-att-class="{ 'destaque': k.destaque }" t-on-click="() => this.openKpi(k.click)" role="button">
                                    <div class="o_vas_kpi_label">
                                        <i t-attf-class="fa {{ k.icon }}"/>
                                        <span t-esc="k.label"/>
                                        <i class="fa fa-info-circle o_vas_info" t-att-title="k.info" aria-label="Definição"/>
                                    </div>
                                    <div class="o_vas_kpi_valor">
                                        <t t-esc="k.value"/>
                                        <span t-if="k.delta" class="o_vas_delta" t-att-class="k.delta.classe" t-att-title="k.delta.tooltip">
                                            <i t-attf-class="fa {{ k.delta.seta }}"/> <t t-esc="k.delta.texto"/>
                                        </span>
                                    </div>
                                    <div class="o_vas_kpi_sub" t-esc="k.sub"/>
                                </div>
                            </t>
                        </div>
                    </section>

                    <!-- ============================================ ENGAJAMENTO -->
                    <section id="vas_sinais" class="o_vas_secao">
                        <div class="o_vas_secao_titulo">Sinais de intenção</div>
                        <div class="o_vas_par">
                            <div class="o_vas_card">
                                <div class="o_vas_card_head o_vas_head_split">
                                    <div>
                                        <h3>Sinais de intenção ao longo do tempo</h3>
                                        <span class="o_vas_hint"><t t-esc="d.totalIntencao"/> sinais <t t-esc="d.timeline.unit"/>, por origem</span>
                                    </div>
                                    <div class="o_vas_legenda_camp">
                                        <t t-foreach="d.timeline.origens" t-as="o" t-key="o.key">
                                            <span><span class="o_vas_dot" t-att-style="'background:' + o.color"/><t t-esc="o.label"/> <b t-esc="o.count"/></span>
                                        </t>
                                    </div>
                                </div>
                                <div t-if="!d.totalIntencao" class="o_vas_empty">Nenhum sinal de intenção no período selecionado.</div>
                                <div t-else="" class="o_vas_serie">
                                    <div class="o_vas_serie_eixo">
                                        <span t-esc="d.timeline.max"/>
                                        <span t-esc="Math.round(d.timeline.max / 2)"/>
                                        <span>0</span>
                                    </div>
                                    <div class="o_vas_serie_barras">
                                        <t t-foreach="d.timeline.bars" t-as="b" t-key="b.key">
                                            <div class="o_vas_sbar" t-att-title="b.title">
                                                <div class="o_vas_sbar_pilha">
                                                    <span t-if="b.total" class="o_vas_sbar_total" t-esc="b.total"/>
                                                    <t t-foreach="b.segs" t-as="s" t-key="s.key">
                                                        <div class="o_vas_sbar_seg" t-att-style="'height:' + s.height + '%;background:' + s.color"/>
                                                    </t>
                                                </div>
                                                <div class="o_vas_sbar_label"><t t-if="b.showLabel" t-esc="b.label"/></div>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="o_vas_card">
                                <div class="o_vas_card_head o_vas_head_split">
                                    <div>
                                        <h3>Sinais de intenção por tipo</h3>
                                        <span class="o_vas_hint">ações de pessoas das contas · ordenado por nº de contas</span>
                                    </div>
                                    <a href="#" class="o_vas_link o_vas_noprint" t-on-click.prevent="() => this.openKpi('intencao')">ver sinais <i class="fa fa-angle-right"/></a>
                                </div>
                                <div t-if="!d.tipos.length" class="o_vas_empty">Nenhum sinal de intenção no período.</div>
                                <t t-else="">
                                    <div class="o_vas_hbar o_vas_hbar_tipo o_vas_hbar_head">
                                        <span>tipo</span><span/><span>contas</span><span>sinais</span><span>pts</span>
                                    </div>
                                    <t t-foreach="d.tipos" t-as="t" t-key="t.key">
                                        <div class="o_vas_hbar o_vas_hbar_tipo" role="button" t-on-click="() => this.openTipo(t)">
                                            <div class="o_vas_hbar_nome" t-att-title="t.label" t-esc="t.label"/>
                                            <div class="o_vas_hbar_track"><div class="o_vas_hbar_fill" t-att-class="{ 'resp': t.resposta }" t-att-style="'width:' + t.width + '%'"/></div>
                                            <b t-esc="t.contas"/>
                                            <span t-esc="t.count"/>
                                            <span class="o_vas_hint" t-esc="t.pontos"/>
                                        </div>
                                    </t>
                                </t>
                            </div>
                        </div>
                        <div class="o_vas_bloco">
                            <div class="o_vas_card">
                                <div class="o_vas_card_head">
                                    <h3>Últimos sinais de intenção</h3>
                                    <span class="o_vas_hint">quem da conta fez o quê</span>
                                </div>
                                <div t-if="!d.feed.length" class="o_vas_empty">Sem sinais de intenção no período.</div>
                                <ul class="o_vas_lista o_vas_lista_grade">
                                    <t t-foreach="d.feed" t-as="s" t-key="s.id">
                                        <li t-on-click="() => this.openLead(s.x_lead_id[0])" role="button" t-att-title="s.x_name">
                                            <span class="o_vas_dot" t-att-style="'background:' + s.origem.color" t-att-title="s.origem.label"/>
                                            <div class="o_vas_lista_main">
                                                <div class="o_vas_lista_titulo"><t t-esc="s.x_lead_id[1]"/> <span class="o_vas_hint fw-normal" t-if="s.pessoa">· <t t-esc="s.pessoa"/></span></div>
                                                <div class="o_vas_hint"><t t-esc="s.tipoLabel"/> · <t t-esc="s.quando"/></div>
                                            </div>
                                            <span class="o_vas_pts" t-att-class="{ 'off': !s.x_ativo or !s.x_pontos }"
                                                  t-att-title="s.x_ativo ? 'conta no score' : 'expirado / fora do score'">+<t t-esc="s.x_pontos"/></span>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                    </section>

                    <!-- ============================================ JORNADA -->
                    <section id="vas_jornada" class="o_vas_secao">
                        <div class="o_vas_secao_titulo">Jornada das contas</div>
                        <div class="o_vas_par">
                            <div class="o_vas_card">
                                <div class="o_vas_card_head">
                                    <h3>Posição no pipeline ABM</h3>
                                    <span class="o_vas_hint">etapa atual das <t t-esc="d.totalLeads"/> contas · % da base<t t-if="d.novas"> · <span class="o_vas_badge_novo">+N</span> novas no período</t></span>
                                </div>
                                <div class="o_vas_funil">
                                    <t t-foreach="d.funil" t-as="s" t-key="s.id">
                                        <div class="o_vas_frow" t-att-class="{ 'zero': s.zero }" t-on-click="() => this.openStage(s.id)" role="button">
                                            <div class="o_vas_fnome" t-esc="s.name"/>
                                            <div class="o_vas_ftrack"><div class="o_vas_fbar" t-att-style="'width:' + s.width + '%'"/></div>
                                            <div class="o_vas_fnum" t-esc="s.count"/>
                                            <div class="o_vas_fpct"><t t-esc="s.share"/>%</div>
                                            <div class="o_vas_fnovas"><span t-if="s.novas" class="o_vas_badge_novo" t-esc="'+' + s.novas"/></div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div class="o_vas_card">
                                <div class="o_vas_card_head">
                                    <h3>Temperatura e prontidão</h3>
                                    <span class="o_vas_hint">score atual (0–<t t-esc="scoreMax"/>) · médio <b t-esc="d.scoreMedio"/></span>
                                </div>
                                <div class="o_vas_donut_linha">
                                    <t t-call="abm_setima_dashboard.Donut">
                                        <t t-set="donut" t-value="d.donutFaixas"/>
                                        <t t-set="donutLabel" t-value="'contas'"/>
                                    </t>
                                    <ul class="o_vas_legenda">
                                        <t t-foreach="d.faixas" t-as="f" t-key="f.key">
                                            <li role="button" t-on-click="() => this.openFaixa(f.key)"><span class="o_vas_dot" t-att-style="'background:' + f.color"/><span><t t-esc="f.label"/> <small class="o_vas_hint" t-esc="f.hint"/></span><b t-esc="f.count"/></li>
                                        </t>
                                    </ul>
                                </div>
                                <div class="o_vas_minititulo">Prontidão das contas ativas</div>
                                <t t-foreach="d.prontidao" t-as="p" t-key="p.key">
                                    <div class="o_vas_pront" t-att-title="p.n + ' de ' + p.de">
                                        <span t-esc="p.label"/>
                                        <div class="o_vas_hbar_track"><div class="o_vas_hbar_fill" t-att-style="'width:' + p.pct + '%'"/></div>
                                        <b><t t-esc="p.pct"/>%</b>
                                    </div>
                                </t>
                                <div class="o_vas_minititulo">Cadência</div>
                                <div class="o_vas_stack">
                                    <t t-foreach="d.cadencia" t-as="c" t-key="c.key">
                                        <div t-att-style="'flex:' + c.count + ';background:' + c.color" t-att-title="c.label + ': ' + c.count"/>
                                    </t>
                                </div>
                                <div class="o_vas_chips_info">
                                    <t t-foreach="d.cadencia" t-as="c" t-key="c.key">
                                        <span><span class="o_vas_dot" t-att-style="'background:' + c.color"/><t t-esc="c.label"/> <b t-esc="c.count"/></span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ============================================ VISÃO POR CONTA -->
                    <section id="vas_contas" class="o_vas_secao">
                        <div class="o_vas_secao_titulo">Visão por conta</div>
                        <div class="o_vas_card o_vas_card_tabela">
                            <div class="o_vas_card_head o_vas_head_split">
                                <div>
                                    <h3>Contas do programa</h3>
                                    <span class="o_vas_hint">score, mídia, comitê e cadência são a foto atual · intenção conta só o período</span>
                                </div>
                                <div class="o_vas_tabs o_vas_noprint" role="tablist">
                                    <span class="o_vas_rotulo">Ordenar:</span>
                                    <t t-foreach="ordens" t-as="o" t-key="o[0]">
                                        <button type="button" role="tab" t-att-class="{ 'active': state.sort === o[0] }" t-on-click="() => this.onSort(o[0])" t-esc="o[1]"/>
                                    </t>
                                </div>
                            </div>
                            <div class="o_vas_tabela_wrap">
                                <table class="o_vas_tabela o_vas_tabela_contas">
                                    <thead>
                                        <tr>
                                            <th>Conta<small>tier · etapa</small></th>
                                            <th class="o_vas_col_score">Score<small>0–90 · fria / engajada / quente</small></th>
                                            <th title="Sinais de intenção (fora o relatório do LinkedIn Ads) no período">Intenção no período<small>sinais · pontos</small></th>
                                            <th title="Sinal de intenção mais recente, em qualquer data">Último sinal de intenção<small>o quê · quando</small></th>
                                            <th class="num" title="Impressões do LinkedIn Ads na empresa ÷ público estimado na segmentação da campanha">Mídia · frequência<small>impressões por pessoa</small></th>
                                            <th class="num" title="Decisores mapeados / total de pessoas no comitê de compra">Comitê<small>decisores / pessoas</small></th>
                                            <th>Cadência</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.contasTodas ? d.contas : d.contas.slice(0, 15)" t-as="c" t-key="c.id">
                                            <tr t-on-click="() => this.openLead(c.id)">
                                                <td class="o_vas_conta">
                                                    <div class="o_vas_conta_nome">
                                                        <span class="o_vas_tier" t-if="c.lead.x_abm_tier">T<t t-esc="c.lead.x_abm_tier"/></span>
                                                        <b t-esc="c.lead.name"/>
                                                        <span t-if="c.nova" class="o_vas_badge_novo">nova</span>
                                                    </div>
                                                    <div class="o_vas_hint" t-esc="c.stage"/>
                                                </td>
                                                <td class="o_vas_col_score">
                                                    <div class="o_vas_score" t-att-title="c.faixa.label + ' (' + c.score + ' de 90)'">
                                                        <div class="o_vas_score_track">
                                                            <div class="o_vas_score_fill" t-att-style="'width:' + c.scorePct + '%;background:' + c.faixa.color"/>
                                                            <span class="o_vas_score_mark m30"/>
                                                            <span class="o_vas_score_mark m60"/>
                                                        </div>
                                                        <b t-esc="c.score"/>
                                                    </div>
                                                </td>
                                                <td>
                                                    <t t-if="c.intN"><b t-esc="c.intN"/> <span class="o_vas_hint">· +<t t-esc="c.intPts"/> pts</span></t>
                                                    <span t-else="" class="zero">—</span>
                                                </td>
                                                <td class="o_vas_ultimo" t-att-title="c.ultimoTitulo">
                                                    <t t-if="c.ultimo"><span t-esc="c.ultimo"/> <span class="o_vas_hint">· <t t-esc="c.ultimoQuando"/></span></t>
                                                    <span t-else="" class="zero">nenhum</span>
                                                </td>
                                                <td class="num" t-att-title="c.midia.titulo">
                                                    <span t-if="c.midia.faixa" class="o_vas_midia" t-att-class="c.midia.faixa.key"><t t-esc="c.midia.texto"/><small t-esc="c.midia.faixa.label"/></span>
                                                    <span t-else="" class="zero" t-esc="c.midia.texto"/>
                                                </td>
                                                <td class="num">
                                                    <t t-if="c.comite">
                                                        <span t-att-class="{ 'o_vas_sem_decisor': !c.decisores }" t-esc="c.decisores"/>
                                                        <span class="o_vas_hint"> / <t t-esc="c.comite"/></span>
                                                    </t>
                                                    <span t-else="" class="zero" title="comitê não mapeado">—</span>
                                                </td>
                                                <td><span class="o_vas_cad"><span class="o_vas_dot" t-att-style="'background:' + c.cadencia.color"/><t t-esc="c.cadencia.label"/></span></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <a t-if="d.contas.length > 15" href="#" class="o_vas_link o_vas_ver_todas o_vas_noprint" t-on-click.prevent="() => this.state.contasTodas = !this.state.contasTodas">
                                <t t-esc="state.contasTodas ? 'mostrar só as 15 primeiras' : 'ver todas as ' + d.contas.length + ' contas'"/>
                            </a>
                        </div>
                    </section>

                    <footer class="o_vas_rodape">
                        <div>Painel preparado pela <b>Vivaz</b> para a <b>Sétima</b> · fonte: CRM Odoo, equipe ABM Setima · atualizado às <t t-esc="d.loadedAt"/></div>
                        <a href="#" class="o_vas_link o_vas_noprint" t-on-click.prevent="() => this.state.glossarioAberto = true"><i class="fa fa-book"/> Glossário de métricas</a>
                    </footer>
                </main>
            </t>
            <div t-elif="state.loading" class="o_vas_wrap o_vas_empty o_vas_empty_lg"><i class="fa fa-circle-o-notch fa-spin me-2"/>Carregando painel ABM…</div>

            <div t-if="state.glossarioAberto" class="o_vas_modal_fundo o_vas_noprint" t-on-click.self="() => this.state.glossarioAberto = false">
                <div class="o_vas_modal" role="dialog" aria-label="Glossário de métricas">
                    <div class="o_vas_card_head o_vas_head_split">
                        <h3>Glossário de métricas</h3>
                        <button type="button" class="btn btn-sm btn-light" t-on-click="() => this.state.glossarioAberto = false" aria-label="Fechar"><i class="fa fa-times"/></button>
                    </div>
                    <dl>
                        <t t-foreach="glossario" t-as="g" t-key="g_index">
                            <dt t-esc="g[0]"/><dd t-esc="g[1]"/>
                        </t>
                    </dl>
                </div>
            </div>
        </div>
    </t>
</templates>
