<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Frequência de mídia por conta (LinkedIn Ads). Só informativo: não entra no score.
         impressões da empresa no período ÷ público estimado na segmentação (Apollo calibrado
         pelo tamanho do público do LinkedIn). Preenchido por script/importação. -->
    <record id="field_lead_midia_freq" model="ir.model.fields">
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="name">x_abm_midia_freq</field>
        <field name="field_description">ABM · Frequência de mídia (impr./pessoa da segmentação)</field>
        <field name="ttype">float</field>
        <field name="state">manual</field>
    </record>
    <record id="field_lead_midia_impressoes" model="ir.model.fields">
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="name">x_abm_midia_impressoes</field>
        <field name="field_description">ABM · Impressões de mídia no período</field>
        <field name="ttype">integer</field>
        <field name="state">manual</field>
    </record>
    <record id="field_lead_midia_publico" model="ir.model.fields">
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="name">x_abm_midia_publico</field>
        <field name="field_description">ABM · Público estimado na segmentação</field>
        <field name="ttype">integer</field>
        <field name="state">manual</field>
    </record>
    <record id="field_lead_midia_periodo" model="ir.model.fields">
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="name">x_abm_midia_periodo</field>
        <field name="field_description">ABM · Período da medição de mídia</field>
        <field name="ttype">char</field>
        <field name="state">manual</field>
    </record>
</odoo>
