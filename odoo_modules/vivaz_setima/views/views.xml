<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pipeline da equipe Pipeline Sétima (crm.team 4) com as telas padrão do CRM. -->
    <record id="action_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline Sétima</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('type', '=', 'opportunity'), ('team_id', '=', 4)]</field>
        <field name="context">{'default_type': 'opportunity', 'default_team_id': 4}</field>
        <field name="search_view_id" ref="crm.view_crm_case_opportunities_filter"/>
    </record>

    <!-- Dashboard de resultado (tela OWL que lê o CRM ao vivo com a sessão de quem vê). -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Resultado comercial · Sétima</field>
        <field name="tag">vivaz_setima_dashboard</field>
    </record>

    <!-- CRM / Sétima, logo depois de Inbound Sétima (sequence 3). -->
    <menuitem id="menu_root" name="Sétima" parent="crm.crm_menu_root" sequence="4"/>
    <menuitem id="menu_pipeline" name="Pipeline" parent="menu_root" action="action_pipeline" sequence="1"/>
    <menuitem id="menu_dashboard" name="Dashboard" parent="menu_root" action="action_dashboard" sequence="2"/>
</odoo>
